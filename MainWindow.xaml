<Window x:Class="SparkXPenPlotter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SparkX Pen Plotter Studio" Height="820" Width="1240"
        MinHeight="700" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="#0f172a" Foreground="#f8fafc"
        FontFamily="Segoe UI, -apple-system, Roboto, sans-serif">

    <Window.Resources>
        <!-- Modern Button Styles -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#334155"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#475569"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#0284c7"/>
            <Setter Property="FontSize" Value="14"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0369a1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WarningButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#d97706"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#b45309"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#dc2626"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#b91c1c"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Modern TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1e293b"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="BorderBrush" Value="#475569"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1e293b"/>
            <Setter Property="Foreground" Value="#ffffff"/>
            <Setter Property="BorderBrush" Value="#475569"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Main Body -->
            <RowDefinition Height="Auto"/> <!-- Bottom Status & Actions Bar -->
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#1e293b" BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="✒️ SparkX Pen Plotter Studio" FontSize="20" FontWeight="Bold" Foreground="#38bdf8"/>
                    <TextBlock Text="· Creality SparkX i7 Control" FontSize="13" Foreground="#94a3b8" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>

                <!-- Connection bar in Header -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#ef4444" Margin="0,0,8,0"/>
                    <TextBlock x:Name="StatusText" Text="Disconnesso" Foreground="#cbd5e1" VerticalAlignment="Center" Margin="0,0,14,0" FontWeight="SemiBold"/>
                    <TextBlock Text="IP Stampante:" VerticalAlignment="Center" Foreground="#94a3b8" Margin="0,0,6,0"/>
                    <TextBox x:Name="TxtPrinterIp" Text="192.168.78.50" Width="120" Margin="0,0,8,0"/>
                    <Button Content="Verifica Connessione" Click="BtnCheckConnection_Click" Padding="10,5" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN BODY -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/> <!-- Sidebar Controls -->
                <ColumnDefinition Width="*"/>   <!-- Interactive Canvas Preview -->
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Background="#182234" Padding="18">
                <StackPanel>

                    <!-- Step 1: File Loading -->
                    <Border Background="#1e293b" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="1. SORGENTE DISEGNO" FontWeight="Bold" Foreground="#38bdf8" Margin="0,0,0,8"/>
                            <Border x:Name="DropBorder" Background="#0f172a" BorderBrush="#475569" BorderThickness="1.5" CornerRadius="6" 
                                    Padding="15" AllowDrop="True" Drop="DropBorder_Drop" DragOver="DropBorder_DragOver" Cursor="Hand" MouseDown="DropBorder_MouseDown">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="📁 Trascina qui un file SVG, JPG o PNG" Foreground="#cbd5e1" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                                    <TextBlock Text="oppure fai clic per sfogliare" Foreground="#64748b" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                    <TextBlock x:Name="TxtLoadedFileName" Text="Nessun file caricato" Foreground="#38bdf8" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Step 2: Tool & Vectorization Settings -->
                    <Border Background="#1e293b" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="2. STILE TRATTO &amp; VETTORIZZAZIONE" FontWeight="Bold" Foreground="#38bdf8" Margin="0,0,0,10"/>
                            
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Tipo di Punta:" Foreground="#cbd5e1" VerticalAlignment="Center"/>
                                <ComboBox x:Name="CmbPreset" Grid.Column="1" Width="180" SelectionChanged="CmbPreset_SelectionChanged">
                                    <ComboBoxItem Content="Pennarello (Marker)" IsSelected="True"/>
                                    <ComboBoxItem Content="Penna a sfera / Fine"/>
                                    <ComboBoxItem Content="Artistico / Dettagliato"/>
                                </ComboBox>
                            </Grid>

                            <StackPanel Margin="0,0,0,10">
                                <Grid>
                                    <TextBlock Text="Soglia Dettaglio Bordi:" Foreground="#94a3b8" FontSize="12"/>
                                    <TextBlock x:Name="TxtThresholdVal" Text="45" Foreground="#38bdf8" HorizontalAlignment="Right" FontSize="12"/>
                                </Grid>
                                <Slider x:Name="SliderThreshold" Minimum="20" Maximum="140" Value="45" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="SliderThreshold_ValueChanged"/>
                            </StackPanel>

                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Filtro Anti-Macchia (Min stroke mm):" Foreground="#94a3b8" FontSize="12"/>
                                    <TextBlock x:Name="TxtMinStrokeVal" Text="4.0 mm" Foreground="#38bdf8" HorizontalAlignment="Right" FontSize="12"/>
                                </Grid>
                                <Slider x:Name="SliderMinStroke" Minimum="1.0" Maximum="10.0" Value="4.0" TickFrequency="0.5" ValueChanged="SliderMinStroke_ValueChanged"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Step 3: Bed & Paper Dimensions -->
                    <Border Background="#1e293b" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="3. FOGLIO &amp; MARGINI" FontWeight="Bold" Foreground="#38bdf8" Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Piatto (L x A mm):" Foreground="#cbd5e1" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtBedW" Grid.Column="1" Text="260" TextChanged="Setting_TextChanged"/>
                                <TextBlock Grid.Column="2" Text="x" Foreground="#64748b" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtBedH" Grid.Column="3" Text="260" TextChanged="Setting_TextChanged"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Foglio (L x A mm):" Foreground="#cbd5e1" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtPaperW" Grid.Column="1" Text="200" TextChanged="Setting_TextChanged"/>
                                <TextBlock Grid.Column="2" Text="x" Foreground="#64748b" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtPaperH" Grid.Column="3" Text="150" TextChanged="Setting_TextChanged"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Margine di sicurezza:" Foreground="#cbd5e1"/>
                                    <TextBlock Text="Almeno 10 mm da ogni bordo" Foreground="#10b981" FontSize="11"/>
                                </StackPanel>
                                <TextBox x:Name="TxtMargin" Grid.Column="1" Text="15" TextChanged="Setting_TextChanged"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Step 4: Z Heights & Speeds -->
                    <Border Background="#1e293b" CornerRadius="8" Padding="14">
                        <StackPanel>
                            <TextBlock Text="4. QUOTE Z &amp; VELOCITÀ" FontWeight="Bold" Foreground="#38bdf8" Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Z Disegno / Z Volo:" Foreground="#cbd5e1" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtZDraw" Grid.Column="1" Text="5.0" TextChanged="Setting_TextChanged"/>
                                <TextBlock Grid.Column="2" Text="/" Foreground="#64748b" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtZTravel" Grid.Column="3" Text="8.0" TextChanged="Setting_TextChanged"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Vel. Disegno / Volo:" Foreground="#cbd5e1" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtDrawSpeed" Grid.Column="1" Text="1500" TextChanged="Setting_TextChanged"/>
                                <TextBlock Grid.Column="2" Text="/" Foreground="#64748b" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtTravelSpeed" Grid.Column="3" Text="3000" TextChanged="Setting_TextChanged"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- RIGHT / CENTER CANVAS (PREVIEW) -->
            <Border Grid.Column="1" Background="#0f172a" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Background="#1e293b" CornerRadius="10" BorderBrush="#334155" BorderThickness="1" ClipToBounds="True">
                        <Viewbox Stretch="Uniform">
                            <Canvas x:Name="PreviewCanvas" Width="520" Height="520" Background="#182234"/>
                        </Viewbox>
                    </Border>

                    <!-- Preview Legend -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                            <Border Width="12" Height="12" Background="#f8fafc" BorderBrush="#cbd5e1" BorderThickness="1" CornerRadius="2" Margin="0,0,6,0"/>
                            <TextBlock Text="Foglio di carta" Foreground="#cbd5e1" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                            <Border Width="12" Height="12" Background="#0284c7" CornerRadius="2" Margin="0,0,6,0"/>
                            <TextBlock Text="Tratto penna (disegno)" Foreground="#cbd5e1" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                            <Border Width="12" Height="2" Background="#f43f5e" Margin="0,5,6,0"/>
                            <TextBlock Text="Spostamenti in volo (Z-Hop)" Foreground="#cbd5e1" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="#10b981" Margin="0,0,6,0"/>
                            <TextBlock Text="Centro / Inizio quota" Foreground="#cbd5e1" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- BOTTOM STATUS & ACTIONS BAR -->
        <Border Grid.Row="2" Background="#1e293b" BorderBrush="#334155" BorderThickness="0,1,0,0" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left info & progress -->
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock x:Name="TxtStrokesInfo" Text="Tratti vettoriali: 0" Foreground="#38bdf8" FontWeight="SemiBold" Margin="0,0,20,0"/>
                        <TextBlock x:Name="TxtToolheadPos" Text="Posizione: X=-- Y=-- Z=--" Foreground="#94a3b8" Margin="0,0,20,0"/>
                        <TextBlock x:Name="TxtPrintState" Text="Stato: Inattivo" Foreground="#cbd5e1"/>
                    </StackPanel>
                    <ProgressBar x:Name="PrintProgress" Height="8" Width="380" HorizontalAlignment="Left" Background="#334155" Foreground="#0284c7" Value="0"/>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🏠 Parcheggia" Click="BtnPark_Click" Margin="0,0,10,0"/>
                    <Button Content="💾 Salva G-Code" Click="BtnSaveGCode_Click" Margin="0,0,10,0"/>
                    <Button Content="⚡ Test in Aria (Dry-Run)" Click="BtnDryRun_Click" Style="{StaticResource WarningButton}" Margin="0,0,10,0"/>
                    <Button Content="▶ AVVIA DISEGNO SU CARTA" Click="BtnStartPrint_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"/>
                    <Button Content="⏸ Pausa" Click="BtnPause_Click" Margin="0,0,6,0"/>
                    <Button Content="⏹ Annulla" Click="BtnCancel_Click" Style="{StaticResource DangerButton}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
